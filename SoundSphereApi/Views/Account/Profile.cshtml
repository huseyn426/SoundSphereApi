@using SoundSphereApi.Helpers

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Profile";

    var userName = Context.Session.GetString("UserName") ?? "User";
    var email = Context.Session.GetString("UserEmail") ?? "";
    var role = Context.Session.GetString("UserRole") ?? "User";
    var playlists = ViewBag.Playlists as IEnumerable<SoundSphereApi.DTOs.Playlist.PlaylistGetDto>;
    var recentTracks = ViewBag.RecentTracks as IEnumerable<SoundSphereApi.DTOs.Music.TrackGetDto>;
    var playlistCount = playlists?.Count() ?? 0;
}

<section class="profile-page">
    <div class="profile-header-card">
        <div class="profile-avatar-lg">
            @userName.Substring(0, 1).ToUpper()
        </div>
        <div class="profile-header-info">
            <div class="profile-type-badge">@role</div>
            <h1>@userName</h1>
            <p class="profile-email">@email</p>
            <div class="profile-stats-row">
                <div class="profile-stat">
                    <span class="stat-num">@playlistCount</span>
                    <span class="stat-label" data-i18n="nav.playlists">Playlists</span>
                </div>
            </div>
        </div>
    </div>

    <div class="profile-sections">
        <div class="profile-section">
            <div class="section-header">
                <h2 data-i18n="profile.edit">Edit Profile</h2>
            </div>
            <form method="post" asp-action="UpdateProfile" class="profile-form">
                <div class="form-row">
                    <div class="form-group">
                        <label data-i18n="profile.fullName">Full Name</label>
                        <input type="text" name="fullName" value="@(ViewBag.FullName ?? userName)" class="form-input" />
                    </div>
                    <div class="form-group">
                        <label data-i18n="auth.username">Username</label>
                        <input type="text" name="userName" value="@userName" class="form-input" />
                    </div>
                </div>
                <div class="form-group">
                    <label data-i18n="profile.imageUrl">Profile Image URL</label>
                    <input type="text" name="profileImageUrl" value="@(ViewBag.ProfileImageUrl ?? "")" class="form-input"
                           placeholder="https://example.com/avatar.jpg" />
                </div>
                <button type="submit" class="btn-primary" data-i18n="common.save">Save Changes</button>
            </form>

            @if (TempData["ProfileSuccess"] != null)
            {
                <div class="toast-success">@TempData["ProfileSuccess"]</div>
            }
            @if (TempData["ProfileError"] != null)
            {
                <div class="toast-error">@TempData["ProfileError"]</div>
            }
        </div>

        @if (playlists != null && playlists.Any())
        {
            <div class="profile-section">
                <div class="section-header">
                    <h2 data-i18n="home.yourPlaylists">My Playlists</h2>
                    <a href="/Playlists" class="see-all-link" data-i18n="common.seeAll">See all →</a>
                </div>
                <div class="playlist-grid">
                    @foreach (var pl in playlists.Take(6))
                    {
                        <a href="/Playlists/Details/@pl.Id" class="playlist-card clickable">
                            <div class="playlist-icon">♪</div>
                            <div class="playlist-name">@pl.Name</div>
                            <div class="playlist-meta">@(pl.IsPublic ? "Public" : "Private")</div>
                        </a>
                    }
                </div>
            </div>
        }

        @if (recentTracks != null && recentTracks.Any())
        {
            <div class="profile-section">
                <div class="section-header">
                    <h2 data-i18n="home.recentlyPlayed">Recently Played</h2>
                </div>
                <div class="track-table">
                    @{ var i = 1; }
                    @foreach (var track in recentTracks.Take(8))
                    {
                        <div class="track-item" data-track-id="@track.Id"
                             data-title="@track.Title" data-artist="@track.ArtistName"
                             data-audio="@track.AudioUrl" data-cover="@track.CoverImageUrl"
                             data-duration="@track.Duration.ToString(@"m\:ss")">
                            <div class="track-index">
                                <span class="index-num">@i</span>
                                <button class="play-icon" onclick="playTrackFromList(this)">▶</button>
                            </div>
                            <div class="track-title-cell">
                                <div class="track-cover-mini"
                                     style="@(string.IsNullOrEmpty(track.CoverImageUrl) ? "" : $"background-image:url({track.CoverImageUrl});background-size:cover;")">
                                </div>
                                <div class="track-title-wrap">
                                    <div class="track-name">@track.Title</div>
                                    <div class="track-caption">@track.ArtistName</div>
                                </div>
                            </div>
                            <div class="track-col">@track.ArtistName</div>
                            <div class="track-col">@track.Duration.ToString(@"m\:ss")</div>
                        </div>
                        i++;
                    }
                </div>
            </div>
        }
    </div>
</section>

<script src="~/js/player.js"></script>
