@using SoundSphereApi.Helpers
@using System.Text.Json

<!DOCTYPE html>
<html lang="@UiText.Current(Context)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@UiText.Get(Context, "brand")</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="~/js/i18n.js" asp-append-version="true"></script>
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js');
            });
        }
    </script>
</head>
<body class="dark-theme">
    @{
        var sessionUserId = Context.Session.GetInt32("UserId");
        var hasServerSession = sessionUserId != null;
    }
    @if (hasServerSession)
    {
        <script>
            try { sessionStorage.removeItem('ss_sync_attempts'); } catch (e) { }
            localStorage.setItem('token', @Html.Raw(JsonSerializer.Serialize(Context.Session.GetString("JWToken"))));
            localStorage.setItem('username', @Html.Raw(JsonSerializer.Serialize(Context.Session.GetString("UserName"))));
            localStorage.setItem('role', @Html.Raw(JsonSerializer.Serialize(Context.Session.GetString("UserRole"))));
        </script>
    }
    else
    {
        <script>
            (function () {
                var t = localStorage.getItem('token');
                if (!t) return;
                var n = parseInt(sessionStorage.getItem('ss_sync_attempts') || '0', 10);
                if (n >= 2) {
                    localStorage.removeItem('token');
                    localStorage.removeItem('username');
                    localStorage.removeItem('role');
                    sessionStorage.removeItem('ss_sync_attempts');
                    return;
                }
                sessionStorage.setItem('ss_sync_attempts', String(n + 1));
                fetch('/Account/SyncSession', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ token: t })
                }).then(function (r) {
                    if (r.ok) {
                        try { sessionStorage.removeItem('ss_sync_attempts'); } catch (e) { }
                        location.reload();
                        return;
                    }
                    if (r.status === 401) {
                        localStorage.removeItem('token');
                        localStorage.removeItem('username');
                        localStorage.removeItem('role');
                        sessionStorage.removeItem('ss_sync_attempts');
                    }
                }).catch(function () { });
            })();
        </script>
    }
    <div class="shell">
        <aside class="sidebar">
            <a href="/" class="logo">@UiText.Get(Context, "brand")</a>

            <nav class="sidebar-nav">
                <span class="nav-section" data-i18n="nav.menu">Menu</span>
                <a href="/" class="nav-item @(Context.Request.Path == "/" ? "nav-active" : "")">
                    <span class="nav-icon">🏠</span> <span data-i18n="nav.home">@UiText.Get(Context, "home")</span>
                </a>
                <a href="/Music/Tracks" class="nav-item @(Context.Request.Path.StartsWithSegments("/Music") ? "nav-active" : "")">
                    <span class="nav-icon">🎵</span> <span data-i18n="nav.tracks">@UiText.Get(Context, "tracks")</span>
                </a>
                <a href="/Playlists" class="nav-item @(Context.Request.Path.StartsWithSegments("/Playlists") ? "nav-active" : "")">
                    <span class="nav-icon">📋</span> <span data-i18n="nav.playlists">Playlists</span>
                </a>
                <a href="/Music/Explore" class="nav-item @(Context.Request.Path == "/Music/Explore" ? "nav-active" : "")">
                    <span class="nav-icon">🌍</span> <span data-i18n="nav.explore">Explore</span>
                </a>
                <a href="/Music/Charts" class="nav-item @(Context.Request.Path == "/Music/Charts" ? "nav-active" : "")">
                    <span class="nav-icon">📈</span> <span data-i18n="nav.charts">Charts</span>
                </a>

                @if (Context.Session.GetInt32("UserId") != null)
                {
                    <span class="nav-section" data-i18n="nav.yourMusic">Your Music</span>
                    <a href="/Music/Liked" class="nav-item @(Context.Request.Path == "/Music/Liked" ? "nav-active" : "")">
                        <span class="nav-icon">❤️</span> <span data-i18n="nav.liked">Liked Songs</span>
                    </a>
                    <a href="/Music/History" class="nav-item @(Context.Request.Path == "/Music/History" ? "nav-active" : "")">
                        <span class="nav-icon">🕒</span> <span data-i18n="nav.history">History</span>
                    </a>

                    <span class="nav-section" data-i18n="nav.account">Account</span>
                    <a href="/Account/Profile" class="nav-item @(Context.Request.Path.StartsWithSegments("/Account/Profile") ? "nav-active" : "")">
                        <span class="nav-icon">👤</span> <span data-i18n="nav.profile">Profile</span>
                    </a>
                    <a href="/Subscription/Plans" class="nav-item @(Context.Request.Path.StartsWithSegments("/Subscription") ? "nav-active" : "")">
                        <span class="nav-icon">💎</span> <span data-i18n="nav.subscription">Subscription</span>
                    </a>

                    @if (Context.Session.GetString("UserRole") == "Admin")
                    {
                        <span class="nav-section" data-i18n="nav.adminPanel">Admin</span>
                        <a href="/AdminPanel/Dashboard" class="nav-item @(Context.Request.Path == "/AdminPanel/Dashboard" ? "nav-active" : "")">
                            <span class="nav-icon">⚙️</span> <span data-i18n="nav.admin.dashboard">Dashboard</span>
                        </a>
                        <a href="/AdminPanel/Tracks" class="nav-item @(Context.Request.Path == "/AdminPanel/Tracks" ? "nav-active" : "")">
                            <span class="nav-icon">🎵</span> <span data-i18n="nav.admin.tracks">Tracks</span>
                        </a>
                        <a href="/AdminPanel/Catalog" class="nav-item @(Context.Request.Path == "/AdminPanel/Catalog" ? "nav-active" : "")">
                            <span class="nav-icon">🗂️</span> <span data-i18n="nav.admin.catalog">Catalog</span>
                        </a>
                        <a href="/AdminPanel/Users" class="nav-item @(Context.Request.Path == "/AdminPanel/Users" ? "nav-active" : "")">
                            <span class="nav-icon">👥</span> <span data-i18n="nav.admin.users">Users</span>
                        </a>
                    }
                }
            </nav>
        </aside>

        <div class="main-area">
            <header class="topbar">
                <form method="get" action="/Music/Tracks" class="search-form" id="searchForm">
                    <input type="text"
                           name="search"
                           id="searchInput"
                           value="@Context.Request.Query["search"]"
                           class="search-input"
                           placeholder="@UiText.Get(Context, "search_placeholder")" 
                           data-i18n-placeholder="common.searchPlaceholder"
                           autocomplete="off" />
                    <button type="submit" class="search-btn" data-i18n="common.search">@UiText.Get(Context, "search_button")</button>
                    
                    <div class="search-dropdown" id="searchDropdown">
                        <!-- Results injected here -->
                    </div>
                </form>

                <script>
                    const searchInput = document.getElementById('searchInput');
                    const searchDropdown = document.getElementById('searchDropdown');
                    let searchTimeout;

                    searchInput.addEventListener('input', function(e) {
                        clearTimeout(searchTimeout);
                        const query = e.target.value.trim();
                        
                        if (query.length < 2) {
                            searchDropdown.style.display = 'none';
                            return;
                        }

                        searchTimeout = setTimeout(() => {
                            fetch(`/Music/SearchAjax?query=${encodeURIComponent(query)}`)
                                .then(r => r.json())
                                .then(data => {
                                    if (!data.tracks.length && !data.artists.length && !data.playlists.length) {
                                        searchDropdown.innerHTML = `<div style="padding:16px; text-align:center; color:#a3a3a3;" data-i18n="search.noResults">${window.t('search.noResults')} '${query}'</div>`;
                                        searchDropdown.style.display = 'block';
                                        return;
                                    }

                                    let html = '';
                                    
                                    // Tracks Section
                                    if (data.tracks.length > 0) {
                                        html += `<div class="search-category" data-i18n="search.tracks">${window.t('search.tracks')}</div>`;
                                        data.tracks.forEach(t => {
                                            const img = t.coverImageUrl || '';
                                            html += `
                                                <div class="search-dropdown-item" onclick="playSearchedTrack(${t.id}, '${t.title.replace(/'/g, "\\'")}', '${t.artistName.replace(/'/g, "\\'")}', '${t.audioUrl}', '${img}')">
                                                    <div class="track-cover-mini" style="background-image:url('${img}');"></div>
                                                    <div style="flex:1;">
                                                        <div style="font-weight:bold; color:#fff; font-size:14px;">${t.title}</div>
                                                        <div style="color:#a3a3a3; font-size:12px;">${t.artistName}</div>
                                                    </div>
                                                    <div style="color:#22c55e;">▶</div>
                                                </div>
                                            `;
                                        });
                                    }

                                    // Artists Section
                                    if (data.artists.length > 0) {
                                        html += `<div class="search-category" data-i18n="search.artists">${window.t('search.artists')}</div>`;
                                        data.artists.forEach(a => {
                                            html += `
                                                <a href="/Music/Artist/${a.id}" class="search-dropdown-item">
                                                    <div class="track-cover-mini" style="background-image:url('${a.imageUrl}'); border-radius: 50%;"></div>
                                                    <div style="flex:1;">
                                                        <div style="font-weight:bold; color:#fff; font-size:14px;">${a.name}</div>
                                                    </div>
                                                </a>
                                            `;
                                        });
                                    }

                                    // Playlists Section
                                    if (data.playlists.length > 0) {
                                        html += `<div class="search-category" data-i18n="search.playlists">${window.t('search.playlists')}</div>`;
                                        data.playlists.forEach(p => {
                                            html += `
                                                <a href="/Playlists/Details/${p.id}" class="search-dropdown-item">
                                                    <div class="track-cover-mini">♪</div>
                                                    <div style="flex:1;">
                                                        <div style="font-weight:bold; color:#fff; font-size:14px;">${p.name}</div>
                                                    </div>
                                                </a>
                                            `;
                                        });
                                    }
                                    
                                    html += `<a href="/Music/Tracks?search=${encodeURIComponent(query)}" class="search-see-all" data-i18n="search.seeAll">${window.t('search.seeAll')}</a>`;
                                    
                                    searchDropdown.innerHTML = html;
                                    searchDropdown.style.display = 'block';
                                });
                        }, 300);
                    });

                    // Hide dropdown when clicking outside
                    document.addEventListener('click', function(e) {
                        if (!document.getElementById('searchForm').contains(e.target)) {
                            searchDropdown.style.display = 'none';
                        }
                    });

                    function playSearchedTrack(id, title, artist, url, img) {
                        searchDropdown.style.display = 'none';
                        if (typeof window.playTrack === 'function') {
                            window.playTrack({ id, title, artistName: artist, audioUrl: url, coverImageUrl: img });
                        }
                    }
                </script>

                <div class="topbar-right">
                    <div class="lang-switch top-lang">
                        <a class="lang-link @(UiText.Current(Context) == "en" ? "active" : "")"
                           data-lang="en"
                           href="/Language/Set?culture=en&returnUrl=@Context.Request.Path@Context.Request.QueryString">EN</a>
                        <a class="lang-link @(UiText.Current(Context) == "ru" ? "active" : "")"
                           data-lang="ru"
                           href="/Language/Set?culture=ru&returnUrl=@Context.Request.Path@Context.Request.QueryString">RU</a>
                    </div>

                    @if (Context.Session.GetInt32("UserId") == null)
                    {
                        <a href="/Account/Login" class="topbar-link" data-i18n="auth.loginTitle">@UiText.Get(Context, "login")</a>
                        <a href="/Account/Register" class="topbar-button" data-i18n="auth.registerTitle">@UiText.Get(Context, "register")</a>
                    }
                    else
                    {
                        <a href="/Account/Profile" class="profile-chip">
                            <div class="profile-avatar">
                                @(Context.Session.GetString("UserName")?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <div class="profile-text">
                                <div class="profile-name">@Context.Session.GetString("UserName")</div>
                                <div class="profile-role">@Context.Session.GetString("UserRole")</div>
                            </div>
                        </a>
                        <a href="/Account/Logout" class="topbar-link logout-link" data-i18n="common.logout" onclick="try { localStorage.removeItem('token'); localStorage.removeItem('username'); localStorage.removeItem('role'); } catch (e) { }">@UiText.Get(Context, "logout")</a>
                    }
                </div>
            </header>

            <main class="content-area @(Context.Session.GetInt32("UserId") != null ? "content-area--player" : "")">
                @RenderBody()
            </main>
        </div>
    </div>

    @if (Context.Session.GetInt32("UserId") != null)
    {
        <div class="player-bar">
            <div class="player-track">
                <div class="player-cover"></div>
                <div>
                    <div class="player-title" data-i18n="queue.empty">No track selected</div>
                    <div class="player-subtitle" data-i18n="queue.emptySubtitle">SoundSphere Player</div>
                </div>
                <button class="player-btn player-like-btn" id="player-btn-like" title="Like">🤍</button>
            </div>

            <div class="player-center">
                <div class="player-controls">
                    <button class="player-btn" id="btn-shuffle" data-i18n-title="player.shuffle" title="Shuffle">🔀</button>
                    <button class="player-btn" id="btn-prev" data-i18n-title="common.previous" title="Previous">⏮</button>
                    <button class="player-btn player-main-btn" id="btn-play" data-i18n-title="common.play" title="Play/Pause">▶</button>
                    <button class="player-btn" id="btn-next" data-i18n-title="common.next" title="Next">⏭</button>
                    <button class="player-btn" id="btn-repeat" data-i18n-title="player.repeat" title="Repeat">🔁</button>
                </div>
                <div class="player-progress">
                    <span>0:00</span>
                    <div class="progress-line">
                        <div class="progress-fill"></div>
                    </div>
                    <span>0:00</span>
                </div>
            </div>

            <div class="player-side" style="display:flex; align-items:center; gap:12px;">
                <button class="player-btn" id="btn-queue" title="Queue">≡</button>
                <div class="player-volume-wrap" style="display:flex; align-items:center; gap:8px;">
                    <button class="player-btn" id="btn-mute" style="font-size:16px;">🔊</button>
                    <input type="range" id="volume-slider" min="0" max="1" step="0.01" value="1" class="volume-slider" />
                </div>
            </div>
        </div>
        
        <div class="queue-panel" id="queue-panel">
            <div class="queue-header">
                <h3 data-i18n="queue.title">Queue</h3>
                <button class="close-btn" onclick="document.getElementById('queue-panel').classList.remove('active')">×</button>
            </div>
            <div class="queue-list" id="queue-list">
                <!-- Tracks injected here -->
            </div>
        </div>

        <script src="~/js/player.js" asp-append-version="true"></script>
    }
</body>
</html>
