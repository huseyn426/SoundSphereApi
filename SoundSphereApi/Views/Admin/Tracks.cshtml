@model IEnumerable<SoundSphereApi.DTOs.Music.TrackGetDto>
@using SoundSphereApi.Helpers
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Admin - Tracks";
    var artists = (ViewBag.Artists as IEnumerable<SoundSphereApi.DTOs.Music.ArtistGetDto>) ?? Enumerable.Empty<SoundSphereApi.DTOs.Music.ArtistGetDto>();
    var genres = (ViewBag.Genres as IEnumerable<SoundSphereApi.DTOs.Music.GenreGetDto>) ?? Enumerable.Empty<SoundSphereApi.DTOs.Music.GenreGetDto>();
    var albums = (ViewBag.Albums as IEnumerable<SoundSphereApi.DTOs.Music.AlbumGetDto>) ?? Enumerable.Empty<SoundSphereApi.DTOs.Music.AlbumGetDto>();
}

<section class="admin-page fade-in">
    <div style="display:flex; justify-content:space-between; align-items:flex-end;">
        <div>
            <div class="page-label">Admin Panel</div>
            <h1>Manage Tracks</h1>
        </div>
        <button class="btn-primary" onclick="openModal('add')">+ Add Track</button>
    </div>

    <form method="get" action="/AdminPanel/Tracks" style="display:flex; gap:12px; max-width:400px; margin-bottom:24px;">
        <input type="text" name="search" value="@ViewBag.Search" placeholder="Search tracks..." class="form-input" style="flex:1;" />
        <button type="submit" class="btn-secondary">Search</button>
        @if (!string.IsNullOrEmpty(ViewBag.Search))
        {
            <a href="/AdminPanel/Tracks" class="clear-link" style="align-self:center;">Clear</a>
        }
    </form>

    <div class="admin-table">
        <div class="admin-table-head" style="grid-template-columns: 40px 3fr 2fr 1fr 1fr 100px;">
            <div>#</div>
            <div>Title</div>
            <div>Artist</div>
            <div>Genre</div>
            <div>Duration</div>
            <div>Actions</div>
        </div>
        @{ var i = 1; }
        @foreach (var track in Model)
        {
            <div class="admin-table-row" id="row-@track.Id" style="grid-template-columns: 40px 3fr 2fr 1fr 1fr 100px;">
                <div>@i</div>
                <div style="display:flex; align-items:center; gap:12px;">
                    <div class="track-cover-mini" style="background-image:url('@track.CoverImageUrl'); background-size:cover;"></div>
                    <div style="font-weight:700; color:#fff;">@track.Title</div>
                </div>
                <div>@track.ArtistName</div>
                <div>@track.GenreName</div>
                <div>@track.Duration.ToString(@"m\:ss")</div>
                <div class="admin-actions">
                    <button class="mini-btn" onclick="openModal('edit', {
                        id: @track.Id, title: '@Html.Raw(track.Title.Replace("'", "\\'"))', artistId: @track.ArtistId,
                        genreId: @track.GenreId, duration: @track.Duration.TotalSeconds, audioUrl: '@track.AudioUrl',
                        imageUrl: '@track.CoverImageUrl', albumId: @track.AlbumId
                    })">✏️</button>
                    <button class="mini-btn btn-remove" onclick="deleteTrack(@track.Id, '@Html.Raw(track.Title.Replace("'", "\\'"))')">🗑️</button>
                </div>
            </div>
            i++;
        }
    </div>
</section>

<!-- Modal -->
<div id="trackModal" class="modal-overlay" style="display:none;">
    <div class="modal-content">
        <div style="display:flex; justify-content:space-between; margin-bottom: 20px;">
            <h2 id="modalTitle" style="margin:0; color:#fff;">Add Track</h2>
            <button class="mini-btn" onclick="closeModal()">✕</button>
        </div>

        <form id="trackForm" onsubmit="submitForm(event)" class="profile-form">
            <input type="hidden" id="tId" />
            
            <div class="form-group">
                <label>Title *</label>
                <input type="text" id="tTitle" class="form-input" required />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Artist *</label>
                    <select id="tArtist" class="form-input" required>
                        <option value="">Select Artist</option>
                        @foreach(var a in artists) { <option value="@a.Id">@a.Name</option> }
                    </select>
                </div>
                <div class="form-group">
                    <label>Genre *</label>
                    <select id="tGenre" class="form-input" required>
                        <option value="">Select Genre</option>
                        @foreach(var g in genres) { <option value="@g.Id">@g.Name</option> }
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Album *</label>
                    <select id="tAlbum" class="form-input" required>
                        <option value="">Select Album</option>
                        @foreach(var al in albums) { <option value="@al.Id">@al.Title</option> }
                    </select>
                </div>
                <div class="form-group">
                    <label>Duration (Seconds) *</label>
                    <input type="number" id="tDuration" class="form-input" required min="1" placeholder="e.g. 225" />
                </div>
            </div>

            <div class="form-group">
                <label>Audio URL *</label>
                <input type="text" id="tAudio" class="form-input" required />
            </div>

            <div class="form-group">
                <label>Image URL (Optional)</label>
                <input type="text" id="tImage" class="form-input" />
            </div>

            <div style="display:flex; gap:12px; justify-content:flex-end; margin-top:12px;">
                <button type="button" class="btn-secondary" onclick="closeModal()">Cancel</button>
                <button type="submit" class="btn-primary">Save Track</button>
            </div>
        </form>
    </div>
</div>

<script>
    let currentMode = 'add';

    function openModal(mode, data = null) {
        currentMode = mode;
        document.getElementById('modalTitle').innerText = mode === 'add' ? 'Add New Track' : 'Edit Track';
        
        if (mode === 'edit' && data) {
            document.getElementById('tId').value = data.id;
            document.getElementById('tTitle').value = data.title;
            document.getElementById('tArtist').value = data.artistId;
            document.getElementById('tGenre').value = data.genreId;
            document.getElementById('tAlbum').value = data.albumId || '';
            document.getElementById('tDuration').value = data.duration;
            document.getElementById('tAudio').value = data.audioUrl;
            document.getElementById('tImage').value = data.imageUrl || '';
        } else {
            document.getElementById('trackForm').reset();
            document.getElementById('tId').value = '';
        }

        document.getElementById('trackModal').style.display = 'flex';
    }

    function closeModal() {
        document.getElementById('trackModal').style.display = 'none';
    }

    function showToast(msg, isSuccess) {
        const toast = document.createElement('div');
        toast.className = isSuccess ? 'toast-success' : 'toast-error';
        toast.style.position = 'fixed';
        toast.style.bottom = '20px';
        toast.style.right = '20px';
        toast.style.zIndex = '9999';
        toast.innerText = msg;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
    }

    function formatDuration(seconds) {
        const h = Math.floor(seconds / 3600);
        const m = Math.floor((seconds % 3600) / 60);
        const s = seconds % 60;
        return `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
    }

    async function submitForm(e) {
        e.preventDefault();
        
        const durationSec = parseInt(document.getElementById('tDuration').value);
        if (isNaN(durationSec) || durationSec <= 0) {
            showToast('Duration must be greater than 0', false);
            return;
        }

        const albumIdValue = document.getElementById('tAlbum').value;
        if (!albumIdValue) {
            showToast('Album is required', false);
            return;
        }

        const dto = {
            title: document.getElementById('tTitle').value,
            artistId: parseInt(document.getElementById('tArtist').value),
            genreId: parseInt(document.getElementById('tGenre').value),
            albumId: parseInt(albumIdValue),
            duration: formatDuration(durationSec),
            audioUrl: document.getElementById('tAudio').value,
            coverImageUrl: document.getElementById('tImage').value || null
        };

        const id = document.getElementById('tId').value;
        const url = currentMode === 'add' ? '/AdminPanel/CreateTrack' : `/AdminPanel/EditTrack?id=${id}`;
        const method = currentMode === 'add' ? 'POST' : 'PUT';

        try {
            const res = await fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(dto)
            });
            
            const data = await res.json().catch(() => null);
            
            if (res.ok && data?.success) {
                showToast(currentMode === 'add' ? 'Track added successfully ✓' : 'Track updated successfully ✓', true);
                closeModal();
                setTimeout(() => window.location.reload(), 1000);
            } else {
                showToast(data?.message || 'Validation error. Please check all fields.', false);
            }
        } catch (err) {
            showToast('An error occurred while connecting to the server.', false);
        }
    }

    async function deleteTrack(id, title) {
        if (!confirm(`Delete '${title}'? This action cannot be undone.`)) return;

        try {
            const res = await fetch(`/AdminPanel/DeleteTrack?id=${id}`, { method: 'DELETE' });
            const data = await res.json();
            
            if (data.success) {
                showToast('Track deleted successfully ✓', true);
                document.getElementById(`row-${id}`).remove();
            } else {
                showToast(data.message, false);
            }
        } catch (err) {
            showToast('Error deleting track', false);
        }
    }
</script>
